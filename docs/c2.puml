    +setup_encryption() : std::pair<std::vector<unsigned char>, int> : override
    +handle_client(std::shared_ptr<tcp::socket> client_socket) : override void
    +send_tool(nlohmann::json tool, int bot_id, std::shared_ptr<tcp::socket> client_socket) : bool
    +send_update_instructions() : bool
    +send_updates() : bool
    +authenticate_bot() : void
}

