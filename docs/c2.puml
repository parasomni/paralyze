@startuml C2

class LoadBalancer {
    +distribute_traffic() : void
}

class BaseServer {
    -const std::string m_server_address
    -const int m_server_port
    -std::byte m_crypt_key
    -std::string m_log_server_address
    -std::string m_log_server_port
    -std::size_t m_next_io_context
    #BaseLogger *InfoLogger
    #BaseLogger *WarnLogger
    #BaseLogger *FatalLogger
    #BaseLogger *ErrorLogger
    #BaseLogger *DebuggLogger
    #EncryptionStub *m_crypt_stub
    #Essentials *essentials
    #initialize_server_and_logger(const std::string& server_address, int server_port, const std::string& logger_address, int logger_port)
    +get_log_server_address() : const std::string&
    +get_log_server_port() : int
    +get_server_address() : const std::string& const
    +get_server_port() : int
    +get_crypt_key() : std::byte
    +set_crypt_key(std::byte crypt_key) : void
    +start_server() : virtual void
    +react_to_config_update() : virtual void
    +do_accept() : virtual void
    +setup_encryption() : virtual std::pair<std::vector<unsigned char>, int>
    +handle_client(std::shared_ptr<tcp::socket> client_socket) : virtual void
    +BaseServer(const std::string& server_address, int server_port, std::byte crypt_key, const std::string& logger_address, int logger_port)
    +~BaseServer()
}

class CommandServer {
